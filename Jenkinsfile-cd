pipeline {
    agent { label 'docker-agent' }

    environment {
        IMAGE_NAME     = 'test-pipeline-back'
        CONTAINER_NAME = 'test-pipeline-back'
        PORT           = '3000'
        VM_USER        = 'ubuntu'
        VM_IP          = '192.168.139.127'
    }

    stages {

        stage('Deploy') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-credentials',
                    usernameVariable: 'DOCKERHUB_USER',
                    passwordVariable: 'DOCKERHUB_TOKEN'
                )]) {
                    sshagent(['vm-ssh-key-back']) {
                        sh "ssh -o StrictHostKeyChecking=no ${VM_USER}@${VM_IP} 'docker pull ${DOCKERHUB_USER}/${IMAGE_NAME}:latest; docker rm -f ${CONTAINER_NAME} || true; docker run -d --name ${CONTAINER_NAME} -p ${PORT}:3000 ${DOCKERHUB_USER}/${IMAGE_NAME}:latest'"
                    }
                }
            }
        }

    }

    post {
        success {
            echo "Backend déployé sur ${VM_IP}:${PORT}"
        }
        failure {
            echo 'Le déploiement a échoué — vérifier les logs ci-dessus.'
        }
    }
}
